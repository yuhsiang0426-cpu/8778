# ==============================================================================
# 聚餐費用測試器 (Dining Expense Tester)
# 使用基礎語法：變數、數字 (int/float)、布林 (bool)、字串處理、基本輸出 (print)
# ==============================================================================

# ------------------------------------------------------------------------------
# 步驟 1：設定原始資料（模擬從外部或使用者輸入取得的字串與設定）
# ------------------------------------------------------------------------------
raw_bill_text = "  $1,580.50 元  "    # 原始帳單金額字串（包含空白、錢字號、逗號與單位）
raw_people_text = "  4 人 "          # 原始聚餐人數字串
raw_service_fee_rate = "10%"         # 服務費百分比字串
budget_limit_per_person = 450        # 每人預算上限（整數數字）
has_vip_discount = True              # 布林值：是否擁有 VIP 會員折扣（True 代表有，False 代表無）
vip_discount_amount = 100            # VIP 固定折抵金額（整數數字）


# ------------------------------------------------------------------------------
# 步驟 2：字串清理與整理（利用字串方法移除多餘的符號與空白）
# ------------------------------------------------------------------------------
# 說明：文字（字串）無法直接進行加減乘除，必須先將非數字的雜訊清除乾淨。

# 2-1. 清理帳單金額字串
clean_bill = raw_bill_text.strip()           # 去除前後多餘空白 -> "$1,580.50 元"
clean_bill = clean_bill.replace("$", "")     # 去除錢字號 -> "1,580.50 元"
clean_bill = clean_bill.replace(",", "")     # 去除千分位逗號 -> "1580.50 元"
clean_bill = clean_bill.replace("元", "")    # 去除單位 -> "1580.50 "
clean_bill = clean_bill.strip()              # 再次去除尾巴空白 -> "1580.50"

# 2-2. 清理聚餐人數字串
clean_people = raw_people_text.strip()       # 去除前後空白 -> "4 人"
clean_people = clean_people.replace("人", "") # 去除單位 -> "4 "
clean_people = clean_people.strip()          # 去除多餘空白 -> "4"

# 2-3. 清理服務費字串
clean_fee = raw_service_fee_rate.replace("%", "").strip() # 去除百分比符號與空白 -> "10"


# ------------------------------------------------------------------------------
# 步驟 3：文字轉數字（型別轉換 Type Casting）
# ------------------------------------------------------------------------------
# 說明：
# 1. float() 用於將字串轉為「浮點數（小數）」，適合有小數點的金額或百分比。
# 2. int()   用於將字串轉為「整數」，適合不會有小數點的人數。
# 如果沒有做這一步，Python 會把 "100" + "100" 當成文字相接變成 "100100"，而不是 200！

bill_amount = float(clean_bill)              # 字串 "1580.50" -> 浮點數 1580.5
people_count = int(clean_people)             # 字串 "4" -> 整數 4
fee_rate = float(clean_fee) / 100            # 字串 "10" -> 浮點數 10.0 -> 除以 100 變成 0.1


# ------------------------------------------------------------------------------
# 步驟 4：逐步計算費用（遵守數學運算優先順序：先乘除、後加減、括號最優先）
# ------------------------------------------------------------------------------
# 說明：為了讓程式易於閱讀與除錯，我們把每個計算步驟拆開並存成獨立的變數。

# 4-1. 計算服務費金額（先算乘法）
service_fee = bill_amount * fee_rate         # 1580.5 * 0.1 = 158.05

# 4-2. 計算含服務費的總金額（再算加法）
subtotal_with_fee = bill_amount + service_fee # 1580.5 + 158.05 = 1738.55

# 4-3. 計算 VIP 實際折抵金額
# 巧思：在 Python 中，布林值 True 等同於數字 1，False 等同於數字 0。
# 因此可以用「布林值 * 折抵金額」來計算折扣，完全不需要用到 if 判斷式！
actual_discount = has_vip_discount * vip_discount_amount  # True (1) * 100 = 100

# 4-4. 計算最終應付總金額（先算括號內的加減，確保先扣掉折扣）
final_total = subtotal_with_fee - actual_discount         # 1738.55 - 100 = 1638.55

# 4-5. 計算平均每人分攤金額（最後再做除法）
# 注意：如果寫成「總金額 - 折扣 / 人數」，Python 會先算「折扣 / 人數」導致算錯！
# 所以我們分步驟寫，或者使用括號 (subtotal_with_fee - actual_discount) / people_count
cost_per_person = final_total / people_count              # 1638.55 / 4 = 409.6375

# 4-6. 四捨五入到小數點後第 1 位（方便閱讀）
rounded_total = round(final_total, 1)
rounded_per_person = round(cost_per_person, 1)


# ------------------------------------------------------------------------------
# 步驟 5：布林邏輯判斷（測試是否符合預算與條件）
# ------------------------------------------------------------------------------
# 比較運算子（<=, >, ==）會產生布林值（True 或 False）

is_within_budget = cost_per_person <= budget_limit_per_person  # 每人花費是否小於或等於預算？
is_large_group = people_count >= 4                             # 是否為 4 人（含）以上的大桌聚餐？
is_perfect_deal = is_within_budget and has_vip_discount        # 是否「沒超支」且「有 VIP 折扣」？


# ------------------------------------------------------------------------------
# 步驟 6：基本輸出（將整理與計算的結果印在畫面上）
# ------------------------------------------------------------------------------
print("========================================")
print("          聚餐費用測試器報告            ")
print("========================================")
print("【原始資料整理】")
print("原始帳單文字：", raw_bill_text, "-> 轉換後數字：", bill_amount)
print("原始人數文字：", raw_people_text, "-> 轉換後數字：", people_count)
print("服務費比例  ：", fee_rate * 100, "%")
print("----------------------------------------")
print("【費用計算明細】")
print("餐點原價總計：", bill_amount, "元")
print("服務費金額  ：", round(service_fee, 1), "元")
print("VIP 會員折抵：", actual_discount, "元 (VIP狀態:", has_vip_discount, ")")
print("最終應付總額：", rounded_total, "元")
print("平均每人應付：", rounded_per_person, "元")
print("----------------------------------------")
print("【預算與條件測試結果 (布林值)】")
print("每人預算上限：", budget_limit_per_person, "元")
print("是否在預算內：", is_within_budget)
print("是否為四人桌：", is_large_group)
print("是否完美划算：", is_perfect_deal)
print("========================================")

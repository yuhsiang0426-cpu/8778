# ==============================================================================
# 聚餐費用測試器 (Dining Expense Tester) - 自訂新範例三組測試
# 使用基礎語法：變數、數字 (int/float)、布林 (bool)、字串處理、基本輸出 (print)
# ==============================================================================

# 共用基礎設定：服務費率與每人預算
service_rate = 0.10
budget_per_person = 450


# ------------------------------------------------------------------------------
# 測試一：使用原始資料（人數 = "6", 折價券 = 200）
# ------------------------------------------------------------------------------
print("=== 測試一 ===")
event_name = "  BIRTHDAY PARTY  "
meal_amount = " NT$2,400 "
people = "6"
discount = 200

# 1. 整理聚餐名稱：去除頭尾空白並轉成小寫
cleaned_event_name = event_name.strip().lower()

# 2. 整理餐費與人數並轉換型別
# 移除 "NT$", ",", 與空白
cleaned_meal_str = meal_amount.replace("NT$", "").replace(",", "").strip()
cleaned_meal_amount = float(cleaned_meal_str)  # 轉成浮點數供計算
cleaned_people = int(people)                   # 文字人數轉成整數

# 3. 分步計算費用（先算服務費，再加總並扣掉折價券，最後平分）
service_fee = cleaned_meal_amount * service_rate              # 服務費：2400 * 0.10 = 240.0
total_amount = cleaned_meal_amount + service_fee - discount   # 應付總額：2400 + 240 - 200 = 2440.0
cost_per_person = total_amount / cleaned_people               # 每人費用：2440 / 6 = 406.67

# 4. 判斷是否超過預算（布林變數）
is_over_budget = cost_per_person > budget_per_person

# 5. 輸出費用摘要
print(f"聚餐名稱：{cleaned_event_name}")
print(f"原始餐費：{cleaned_meal_amount:.2f} 元")
print(f"服務費：{service_fee:.2f} 元")
print(f"折價券：{discount:.2f} 元")
print(f"應付總額：{total_amount:.2f} 元")
print(f"分攤人數：{cleaned_people} 人")
print(f"每人費用：{cost_per_person:.2f} 元")
print(f"每人預算：{budget_per_person:.2f} 元")
print(f"是否超過預算：{is_over_budget}\n")


